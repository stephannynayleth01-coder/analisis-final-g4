# Copia este archivo como ".env" y ajusta los valores. NUNCA subas ".env" a GitHub.

# Proveedor principal: ollama (local, gratis) | groq (respaldo en la nube) | auto
LLM_PROVIDER=ollama

# --- Ollama (modelo oficial de la actividad: lo fija el docente) ---
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
# Si tu equipo es lento, sube el tiempo máximo de espera (segundos):
# OLLAMA_TIMEOUT=900

# --- Groq (solo si tu portátil no aguanta Ollama) ---
# Crea una clave gratuita en https://console.groq.com y pégala aquí:
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
